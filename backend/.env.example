PORT=5000

# URL of the Phase 1 FastAPI ML service (used by POST /api/analyze).
ML_SERVICE_URL=http://localhost:8000

# --- MongoDB persistence (vehicle analysis history) ---
# If MONGODB_URI is left empty, the backend starts normally but history/
# persistence features are disabled - ML and LLM features are unaffected.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=predictive_maintenance

# --- LLM configuration (Phase 2) ---
# Provider-independent: set LLM_PROVIDER to pick which LLM actually runs.
# Only the key for the chosen provider needs to be filled in.
#
#   LLM_PROVIDER=mock       -> no key needed, rule-based template report (default)
#   LLM_PROVIDER=gemini     -> needs GEMINI_API_KEY
#   LLM_PROVIDER=anthropic  -> needs ANTHROPIC_API_KEY
#
# If the configured provider's key is missing or the API call fails for any
# reason, the server automatically falls back to the mock report and clearly
# labels the response as "mock" or "error_fallback" - it never crashes and
# never pretends a failed call succeeded.
LLM_PROVIDER=mock

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5
